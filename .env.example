# Local development only. Never commit the real .env file.
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Optional local or hosted PostgreSQL connection string. Leave blank to use SQLite locally.
DATABASE_URL=
# Optional: required for VirusTotal URL/attachment reputation lookups.
VIRUSTOTAL_API_KEY=
